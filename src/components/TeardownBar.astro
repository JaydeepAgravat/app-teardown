---
interface Props {
  /** Show rename and delete controls. Used on the worksheet page. */
  manage?: boolean;
}

const { manage = false } = Astro.props;
---

<div class="teardown-bar not-content">
  <label>
    <span>Recording to</span>
    <select class="teardown-select" aria-label="Current teardown"></select>
  </label>
  <button type="button" data-action="new">New teardown</button>
  {
    manage ? (
      <>
        <button type="button" data-action="rename">Rename</button>
        <button type="button" data-action="delete">Delete</button>
      </>
    ) : (
      <a href="/worksheet/">Open worksheet</a>
    )
  }
</div>

<script>
  import { load, current, select, add, rename, remove, CHANGE_EVENT } from '../lib/store';

  const bars = document.querySelectorAll<HTMLElement>('.teardown-bar');

  const paint = () => {
    const state = load();
    bars.forEach((bar) => {
      const menu = bar.querySelector<HTMLSelectElement>('.teardown-select')!;
      menu.replaceChildren(
        ...Object.values(state.apps).map((app) => {
          const option = document.createElement('option');
          option.value = app.id;
          option.textContent = app.name;
          option.selected = app.id === state.current;
          return option;
        })
      );
    });
  };

  bars.forEach((bar) => {
    bar.querySelector<HTMLSelectElement>('.teardown-select')!.addEventListener('change', (event) => {
      select((event.target as HTMLSelectElement).value);
    });
    bar.addEventListener('click', (event) => {
      const action = (event.target as HTMLElement).closest<HTMLElement>('[data-action]')?.dataset.action;
      if (action === 'new') {
        const name = prompt('Name the app or feature you are tearing down:');
        if (name?.trim()) add(name.trim());
      } else if (action === 'rename') {
        const name = prompt('New name:', current().name);
        if (name?.trim()) rename(name.trim());
      } else if (action === 'delete') {
        if (confirm(`Delete the teardown "${current().name}"? This cannot be undone.`)) remove();
      }
    });
  });

  window.addEventListener(CHANGE_EVENT, paint);
  paint();
</script>
